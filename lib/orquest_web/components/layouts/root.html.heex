<!DOCTYPE html>
<html lang="en" class="h-full [scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <script>
      if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <.live_title default="Orquest">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    
    <script type="module">
      import "https://esm.sh/phoenix_html@4.1.1";
      import { Socket } from "https://esm.sh/phoenix@1.7.23";
      import { LiveSocket } from "https://esm.sh/phoenix_live_view@1.1.30";
      import Sortable from "https://esm.sh/sortablejs@1.15.2";

      let Hooks = {};

      Hooks.FolderPicker = {
        mounted() {
          let self = this;
          this.el.addEventListener("click", async (e) => {
            e.preventDefault();
            try {
              // Tenta API moderna File System Access (Chrome 86+, Edge 86+)
              if (typeof window.showDirectoryPicker === "function") {
                const handle = await window.showDirectoryPicker({ mode: "read" });
                // handle.name é o nome REAL do diretório
                self.pushEvent("folder_selected", {
                  name: handle.name,
                  orquestrator_files: await countOrquestratorFiles(handle)
                });
              } else {
                // Fallback: webkitdirectory (não expõe nome real do diretório)
                fallbackPicker(self);
              }
            } catch (err) {
              // Usuário cancelou ou API não disponível — tenta fallback
              if (err.name !== "AbortError" && err.name !== "SecurityError") {
                fallbackPicker(self);
              }
            }
          });
        }
      };

      async function countOrquestratorFiles(dirHandle) {
        try {
          const orquestratorHandle = await dirHandle.getDirectoryHandle("orquestrator");
          let count = 0;
          for await (const _ of orquestratorHandle.values()) {
            count++;
          }
          return count;
        } catch {
          return 0;
        }
      }

      function fallbackPicker(self) {
        const input = document.createElement("input");
        input.type = "file";
        input.webkitdirectory = true;
        input.style.display = "none";

        input.addEventListener("change", (e) => {
          const files = input.files;
          if (files.length > 0) {
            // A API webkitdirectory NÃO expõe o nome do diretório selecionado.
            // Enviamos sem name para que o servidor derive do path digitado pelo usuário.
            self.pushEvent("folder_selected", { name: "" });
          }
        });

        document.body.appendChild(input);
        input.click();
        setTimeout(() => {
          if (input.parentNode) document.body.removeChild(input);
        }, 1000);
      }

      Hooks.Sortable = {
        mounted() {
          let self = this;
          this.sortable = new Sortable(this.el, {
            group: "kanban-cards",
            animation: 150,
            ghostClass: "opacity-50",
            dragClass: "cursor-grabbing",
            onEnd: function (evt) {
              // Prevent the DOM reorder from being visually jittery until LiveView diff applies
              const params = {
                card_id: evt.item.getAttribute("data-id"),
                to_column: evt.to.getAttribute("data-column"),
                new_index: evt.newIndex
              };
              self.pushEvent("move_card", params);
            }
          });
        },
        destroyed() {
          if (this.sortable) this.sortable.destroy();
        }
      };

      Hooks.CopyTmux = {
        mounted() {
          let self = this;
          this.el.addEventListener("click", (e) => {
            e.stopPropagation();
            const cmd = this.el.dataset.cmd;
            if (!cmd) return;
            navigator.clipboard.writeText(cmd).then(() => {
              const original = self.el.innerHTML;
              self.el.innerHTML = '<span class="text-[10px] font-mono text-emerald-400">Copied!</span>';
              setTimeout(() => { self.el.innerHTML = original; }, 1200);
            }).catch(() => {
              const ta = document.createElement("textarea");
              ta.value = cmd;
              document.body.appendChild(ta);
              ta.select();
              document.execCommand("copy");
              document.body.removeChild(ta);
            });
          });
        }
      };

      Hooks.CopyOutput = {
        mounted() {
          this.el.addEventListener("click", (e) => {
            e.stopPropagation();
            const target = document.getElementById(this.el.dataset.target);
            if (!target) return;
            const text = target.textContent;
            navigator.clipboard.writeText(text).then(() => {
              const original = this.el.innerHTML;
              this.el.innerHTML = '<svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
              setTimeout(() => { this.el.innerHTML = original; }, 1200);
            });
          });
        }
      };

      let csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
      let liveSocket = new LiveSocket("/live", Socket, {
        hooks: Hooks,
        params: { _csrf_token: csrfToken }
      });
      liveSocket.connect();
      window.liveSocket = liveSocket;
    </script>
  </head>
  <body class="h-full antialiased">
    {@inner_content}
  </body>
</html>
